/*
 Xbox controller DriverKit port - user client used by the preference pane /
 daemon to read and change per-controller settings (deadzones, inversion,
 button mapping, rumble mode). Replaces IORegistryEntrySetCFProperties on the
 kext. Selectors and structures: Shared/XboxDriverShared.h.

 GPL v2 or later, see Licence.txt.
 */
#ifndef XboxGamepadUserClient_h
#define XboxGamepadUserClient_h

#include <DriverKit/IOUserClient.iig>

class XboxGamepadUserClient : public IOUserClient
{
public:
    virtual bool init() override;
    virtual void free() override;

    virtual kern_return_t Start(IOService *provider) override;
    virtual kern_return_t Stop(IOService *provider) override;

    virtual kern_return_t ExternalMethod(uint64_t selector,
                                         IOUserClientMethodArguments *arguments,
                                         const IOUserClientMethodDispatch *dispatch,
                                         OSObject *target,
                                         void *reference) override;
};

#endif /* XboxGamepadUserClient_h */
